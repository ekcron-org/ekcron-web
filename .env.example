# Where the product dashboard is hosted. Sign-in / sign-up links point here.
# Local dev against the app running on :3000 would be http://localhost:3000
PUBLIC_APP_URL=https://app.ekcron.com

# Contact addresses. `general` is the public front door; `admin` is cited by the
# privacy and terms pages for account, billing, privacy, and security matters.
PUBLIC_CONTACT_EMAIL=hello@ekcron.com
PUBLIC_ADMIN_EMAIL=admin@ekcron.com

# Public code links.
PUBLIC_DEVELOPER_URL=https://github.com/HumbleBee14
PUBLIC_REPO_URL=https://github.com/HumbleBee14/ekcron

# Optional branding / SEO overrides.
