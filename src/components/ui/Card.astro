---
interface Props {
  interactive?: boolean;
  class?: string;
}

const { interactive = false, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "rounded-xl border border-zinc-200 bg-white/70 dark:border-white/10 dark:bg-white/[0.03]",
    interactive &&
      "transition duration-200 ease-out hover:border-zinc-300 hover:bg-white dark:hover:border-white/20 dark:hover:bg-white/[0.06]",
    className,
  ]}
>
  <slot />
</div>
