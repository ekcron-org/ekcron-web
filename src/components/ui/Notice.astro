---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<aside
  class:list={[
    "not-prose rounded-xl border border-accent-200 bg-accent-50/60 p-5 dark:border-accent-800/60 dark:bg-accent-950/30",
    className,
  ]}
>
  {
    title && (
      <p class="font-mono text-xs tracking-[0.14em] text-accent-700 uppercase dark:text-accent-300">
        {title}
      </p>
    )
  }
  <div
    class="mt-2 space-y-3 text-sm/relaxed text-zinc-700 first:mt-0 dark:text-zinc-300"
  >
    <slot />
  </div>
</aside>
