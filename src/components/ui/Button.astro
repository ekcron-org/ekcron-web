---
/** Renders <a> when `href` is set, otherwise <button>. */
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "secondaryOnDark" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  external?: boolean;
  class?: string;
  "aria-label"?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  external = false,
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-lg font-medium whitespace-nowrap transition duration-200 ease-out select-none disabled:pointer-events-none disabled:opacity-50";

const variants = {
  primary:
    "bg-brand-gradient text-white shadow-sm shadow-accent-500/20 hover:brightness-[1.08] hover:shadow-md hover:shadow-accent-500/25 active:brightness-95",
  /* Hairline outline that reads correctly on both surfaces. */
  secondary:
    "border border-zinc-300 bg-white/60 text-zinc-800 hover:border-zinc-400 hover:bg-white hover:text-zinc-950 dark:border-white/15 dark:bg-white/5 dark:text-zinc-200 dark:hover:border-white/25 dark:hover:bg-white/10 dark:hover:text-white",
  secondaryOnDark:
    "border border-white/15 bg-white/5 text-zinc-200 hover:border-white/25 hover:bg-white/10 hover:text-white",
  ghost:
    "text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white",
} as const;

const sizes = {
  sm: "h-8 px-3 text-sm",
  md: "h-10 px-4 text-sm",
  lg: "h-11 px-5 text-[0.9375rem]",
} as const;

const classes = [base, variants[variant], sizes[size], className];
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href ? (
    <a href={href} class:list={classes} {...externalAttrs} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
