---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, body, align = "left", class: className = "" } = Astro.props;
---

<div
  class:list={[
    align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl",
    className,
  ]}
>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2
    class:list={[
      "text-3xl font-semibold text-zinc-950 sm:text-4xl dark:text-white",
      eyebrow && "mt-3",
    ]}
  >
    {title}
  </h2>
  {body && <p class="mt-4 text-lg/relaxed text-zinc-600 dark:text-zinc-400">{body}</p>}
</div>
