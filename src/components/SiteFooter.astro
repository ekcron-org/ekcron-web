---
import { FOOTER_NAV, SITE, CONTACT, FOOTER_TAGLINE } from "../consts";
import Container from "./ui/Container.astro";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-white/10">
  <Container width="wide">
    <div class="grid gap-12 py-16 md:grid-cols-[1.4fr_2fr]">
      <div class="max-w-xs">
        <a
          href="/"
          class="flex items-center gap-2.5 text-[0.9375rem] font-semibold tracking-tight text-zinc-950 dark:text-white"
        >
          <img
            src="/logo-black.svg"
            alt=""
            width="24"
            height="24"
            class="h-6 w-6 dark:hidden"
          />
          <img
            src="/logo-white.svg"
            alt=""
            width="24"
            height="24"
            class="hidden h-6 w-6 dark:block"
          />
          <span>{SITE.name}</span>
        </a>
        <p class="mt-4 text-sm/relaxed text-zinc-600 dark:text-zinc-400">
          {FOOTER_TAGLINE}
        </p>
        <a
          href={`mailto:${CONTACT.general}`}
          class="mt-3 inline-block py-2 font-mono text-xs text-zinc-500 transition-colors hover:text-accent-600 dark:text-zinc-500 dark:hover:text-accent-300"
        >
          {CONTACT.general}
        </a>
        <SocialLinks class="mt-3 -ml-2" />
        <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-500">
          &copy; {year} {SITE.name}
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {
          FOOTER_NAV.map((group) => (
            <div>
              <h2 class="text-xs font-semibold tracking-wide text-zinc-950 uppercase dark:text-white">
                {group.title}
              </h2>
              <ul class="mt-2.5 space-y-0.5">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.href.startsWith("http") ? "_blank" : undefined}
                      rel={
                        link.href.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="inline-block py-2 text-sm text-zinc-600 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

  </Container>
</footer>
