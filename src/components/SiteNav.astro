---
import { NAV, SITE, APP_URL } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-white/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80"
>
  <nav class="mx-auto flex h-14 w-full max-w-5xl items-center gap-6 px-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="22" height="22" class="rounded" />
      <span>{SITE.name}</span>
    </a>

    <div class="hidden items-center gap-5 text-sm sm:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-zinc-600 transition hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white",
              isActive(item.href) && "text-zinc-950 dark:text-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-3">
      <ThemeToggle />
      <a
        href={`${APP_URL}/sign-in`}
        class="rounded-lg border border-zinc-300 px-3.5 py-1.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-400 hover:text-zinc-950 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-white"
      >
        Sign in
      </a>
    </div>
  </nav>
</header>
