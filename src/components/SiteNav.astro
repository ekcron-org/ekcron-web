---
import { NAV, SITE, APP_URL } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";

/* The sign-in route belongs to the app; the site only links to it. */
const SIGN_IN = `${APP_URL}/sign-in`;

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.startsWith("/#")) return false;
  return href === "/" ? path === "/" : path.startsWith(href);
};
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200/80 bg-white/80 backdrop-blur-xl dark:border-white/10 dark:bg-ink-950/80"
>
  <Container width="wide">
    <nav class="flex h-16 items-center gap-8" aria-label="Main">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 text-[0.9375rem] font-semibold tracking-tight text-zinc-950 dark:text-white"
      >
        <img
          src="/logo-black.svg"
          alt=""
          width="26"
          height="26"
          class="h-[26px] w-[26px] dark:hidden"
        />
        <img
          src="/logo-white.svg"
          alt=""
          width="26"
          height="26"
          class="hidden h-[26px] w-[26px] dark:block"
        />
        <span>{SITE.name}</span>
      </a>

      <div class="hidden items-center gap-7 text-sm md:flex">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class:list={[
                "transition-colors duration-150 hover:text-zinc-950 dark:hover:text-white",
                isActive(item.href)
                  ? "text-zinc-950 dark:text-white"
                  : "text-zinc-600 dark:text-zinc-400",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="ml-auto flex items-center gap-2">
        <ThemeToggle />
        <a
          href={SIGN_IN}
          class="hidden px-2 text-sm text-zinc-600 transition-colors hover:text-zinc-950 sm:block dark:text-zinc-400 dark:hover:text-white"
        >
          Sign in
        </a>
        <!--
          Visibility lives on a wrapper: putting `hidden` on the Button itself
          collides with its base `inline-flex` (same specificity, so stylesheet
          order decides and the override silently loses).
        -->
        <span class="hidden sm:block">
          <Button href={SIGN_IN} size="sm">Get started</Button>
        </span>

        <button
          id="nav-toggle"
          type="button"
          class="grid h-9 w-9 place-items-center rounded-lg text-zinc-600 transition hover:bg-zinc-100 md:hidden dark:text-zinc-400 dark:hover:bg-white/10"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </nav>
  </Container>

  <div
    id="nav-mobile"
    hidden
    class="border-t border-zinc-200 bg-white md:hidden dark:border-white/10 dark:bg-ink-950"
  >
    <Container width="wide">
      <div class="flex flex-col py-4">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class="rounded-lg px-2 py-2.5 text-[0.9375rem] text-zinc-700 transition hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-300 dark:hover:bg-white/10 dark:hover:text-white"
            >
              {item.label}
            </a>
          ))
        }
        <div
          class="mt-3 flex flex-col gap-2 border-t border-zinc-200 pt-4 dark:border-white/10"
        >
          <Button href={SIGN_IN} variant="secondary" size="md">Sign in</Button>
          <Button href={SIGN_IN} size="md">Get started</Button>
        </div>
      </div>
    </Container>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-mobile");
    if (!toggle || !menu) return;

    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );

    /* Close on navigation, on Escape, and once the viewport is desktop width. */
    menu.addEventListener("click", (e) => {
      if (e.target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>
