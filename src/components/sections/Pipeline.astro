---
import { PIPELINE } from "../../consts";
import Cell from "../ui/Cell.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<Section id="how-it-works" size="lg">
  <Container width="wide">
    <SectionHeading
      eyebrow="How it works"
      title="From raw data to a model you can run"
      body="Six stages. Run one, or the whole path."
    />

    <ol
      class="mt-14 grid gap-px overflow-hidden rounded-xl border border-zinc-200 bg-zinc-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-white/10 dark:bg-white/10"
    >
      {
        PIPELINE.map((stage) => (
          <li class="contents">
            <Cell
              index={stage.step}
              label={stage.title}
              body={stage.body}
              icon={stage.icon}
              iconPlacement="corner"
            />
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
