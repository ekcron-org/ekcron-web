---
/** Bottom border only; the element above normally draws its own. Pass `border-t` when standalone. */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["border-b border-zinc-200 bg-ink-950 dark:border-white/10", className]}>
  <img
    src="/brand/banner.webp"
    alt=""
    width="1600"
    height="400"
    loading="lazy"
    decoding="async"
    class="h-36 w-full object-cover sm:h-52 lg:h-64"
  />
</div>
