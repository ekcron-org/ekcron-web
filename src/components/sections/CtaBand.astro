---
import { APP_URL } from "../../consts";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

const SIGN_IN = `${APP_URL}/sign-in`;
---

<Section size="sm" divider>
  <Container>
    <div
      class="border-beam relative isolate overflow-hidden rounded-2xl border border-white/10 bg-ink-950 px-7 py-14 sm:px-14"
    >
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div
          class="glow-breathe absolute top-1/2 right-[8%] h-[34rem] w-[34rem] -translate-y-1/2 translate-x-1/4 rounded-full bg-[radial-gradient(closest-side,rgba(36,229,223,0.42),rgba(36,229,223,0.1)_45%,transparent_72%)] blur-2xl"
        >
        </div>
        <div
          class="glow-breathe-slow absolute top-1/2 right-[20%] h-[26rem] w-[26rem] -translate-y-1/3 translate-x-1/3 rounded-full bg-[radial-gradient(closest-side,rgba(163,29,255,0.34),transparent_70%)] blur-3xl"
        >
        </div>
      </div>

      <div class="grid items-center gap-10 md:grid-cols-[1.6fr_1fr]">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Start with one small run
          </h2>
          <p class="mt-4 max-w-lg text-lg/relaxed text-zinc-400">
            Bring a dataset, tune a small open model, and read the scorecard against its base. The
            fastest way to judge whether this fits your task is to run it once.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button
              href={SIGN_IN}
              size="lg"
              class="bg-white! text-zinc-950! hover:bg-zinc-200! active:bg-zinc-300!"
            >
              Get started
            </Button>
            <Button href="/help" variant="secondaryOnDark" size="lg">Read the FAQ</Button>
          </div>
        </div>

        <div class="reveal hidden justify-self-center md:block" data-reveal>
          <img
            src="/brand/coin.webp"
            alt=""
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
            class="coin-float h-60 w-60 [mask-image:radial-gradient(circle,#000_58%,transparent_74%)] drop-shadow-[0_0_56px_rgba(36,229,223,0.4)]"
          />
        </div>
      </div>
    </div>
  </Container>
</Section>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-in");
        io.unobserve(e.target);
      }
    },
    { threshold: 0.3 },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
</script>
