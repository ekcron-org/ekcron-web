---
import { HERO, APP_URL } from "../../consts";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ParticleField from "../visuals/ParticleField.astro";

const SIGN_IN = `${APP_URL}/sign-in`;
---

<div class="relative flex min-h-[calc(100svh-4rem)] flex-col justify-center">
  <Container>
    <div class="mx-auto max-w-3xl pt-10 text-center sm:pt-14">
      <p
        class="flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-zinc-500 uppercase dark:text-zinc-400"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent-600 dark:bg-accent-400"></span>
        {HERO.eyebrow}
      </p>

      <h1
        class="mt-6 text-[2.6rem]/[1.04] font-medium tracking-tight text-zinc-950 sm:text-6xl/[1.02] dark:text-white"
      >
        {HERO.headingLead}<br />
        <span class="text-accent-700 dark:text-accent-400">{HERO.headingAccent}</span>
      </h1>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg/relaxed text-zinc-600 dark:text-zinc-400"
      >
        {HERO.body}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href={SIGN_IN} size="lg">
          {HERO.primaryCta}
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </Button>
        <Button href="#how-it-works" variant="secondary" size="lg">
          {HERO.secondaryCta}
        </Button>
      </div>
    </div>
  </Container>

  <Container width="wide">
    <figure class="mt-10 pb-8 sm:mt-12 sm:pb-10" aria-label="Noise on the left settling into a steady signal on the right">
      <div class="h-28 sm:h-36">
        <ParticleField scene="signal" />
      </div>
      <figcaption
        class="mt-3 flex items-center justify-between font-mono text-[0.6875rem] tracking-[0.16em] text-zinc-500 uppercase dark:text-zinc-500"
      >
        <span>Raw data</span>
        <span class="hidden sm:inline">Training</span>
        <span class="text-accent-700 dark:text-accent-400">Your model</span>
      </figcaption>
    </figure>
  </Container>
</div>
