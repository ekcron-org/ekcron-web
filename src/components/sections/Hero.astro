---
import { HERO, APP_URL, PIPELINE } from "../../consts";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ParticleField from "../visuals/ParticleField.astro";

const SIGN_IN = `${APP_URL}/sign-in`;
---

<div class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="bloom-brand absolute inset-x-0 top-0 h-[32rem] opacity-[0.18] dark:opacity-[0.28]"
    >
    </div>
    <div class="absolute inset-0 text-zinc-900 opacity-70 dark:text-white dark:opacity-100">
      <div class="bg-grid absolute inset-0"></div>
    </div>
    <div
      class="absolute inset-x-0 top-0 h-[34rem] opacity-40 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_30%,transparent_100%)] dark:opacity-70"
    >
      <ParticleField scene="drift" density={0.9} />
    </div>
  </div>

  <Container>
    <div class="mx-auto max-w-3xl pt-20 pb-16 text-center sm:pt-28 sm:pb-20">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/70 px-3 py-1 font-mono text-xs tracking-[0.12em] text-zinc-600 uppercase backdrop-blur dark:border-white/15 dark:bg-white/5 dark:text-zinc-400"
      >
        <span class="bg-brand-gradient h-1.5 w-1.5 rounded-full"></span>
        {HERO.eyebrow}
      </p>

      <h1
        class="mt-7 text-[2.6rem]/[1.08] font-semibold tracking-tight text-zinc-950 sm:text-6xl/[1.05] dark:text-white"
      >
        {HERO.headingLead}{" "}
        <span class="text-brand-gradient">{HERO.headingAccent}</span>
      </h1>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg/relaxed text-zinc-600 sm:text-xl/relaxed dark:text-zinc-400"
      >
        {HERO.body}
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href={SIGN_IN} size="lg">
          {HERO.primaryCta}
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </Button>
        <Button href="#how-it-works" variant="secondary" size="lg">
          {HERO.secondaryCta}
        </Button>
      </div>
    </div>
  </Container>

  <Container width="wide">
    <ol
      class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-zinc-200 bg-zinc-200 sm:grid-cols-3 lg:grid-cols-5 dark:border-white/10 dark:bg-white/10"
    >
      {
        PIPELINE.map((stage, i) => (
          <li
            class:list={[
              "bg-white/80 p-5 backdrop-blur dark:bg-ink-950/80",
              /* Five cards into two or three columns leaves a dead cell; the
                 last one fills the remainder until every card gets its own. */
              i === PIPELINE.length - 1 && "col-span-2 sm:col-span-2 lg:col-span-1",
            ]}
          >
            <span class="font-mono text-xs text-accent-600 dark:text-accent-300">
              {stage.step}
            </span>
            <p class="mt-2 text-sm font-medium text-zinc-950 dark:text-white">
              {stage.title}
            </p>
          </li>
        ))
      }
    </ol>
  </Container>
</div>
