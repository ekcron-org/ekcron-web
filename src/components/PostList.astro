---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  base: string; // "/blog" or "/research"
  posts: (CollectionEntry<"blog"> | CollectionEntry<"research">)[];
  empty?: string;
}

const { base, posts, empty = "Nothing published yet." } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-zinc-500 dark:text-zinc-400">{empty}</p>
  ) : (
    <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {posts.map((post) => (
        <li class="py-5">
          <a href={`${base}/${post.id}/`} class="group block">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-medium text-zinc-900 transition group-hover:text-zinc-600 dark:text-zinc-100 dark:group-hover:text-zinc-300">
                {post.data.title}
              </h2>
              <span class="shrink-0 text-sm text-zinc-400 dark:text-zinc-500">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </div>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
              {post.data.description}
            </p>
          </a>
        </li>
      ))}
    </ul>
  )
}
