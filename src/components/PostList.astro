---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  base: string;
  posts: CollectionEntry<"blog">[];
  empty?: string;
}

const { base, posts, empty = "Nothing published yet." } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-zinc-500 dark:text-zinc-400">{empty}</p>
  ) : (
    <ul class="divide-y divide-zinc-200 dark:divide-white/10">
      {posts.map((post) => (
        <li>
          <a href={`${base}/${post.id}/`} class="group block py-6">
            <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="font-medium text-zinc-950 transition-colors group-hover:text-accent-700 dark:text-white dark:group-hover:text-accent-300">
                {post.data.title}
              </h3>
              <span class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-500">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </div>
            <p class="mt-2 max-w-2xl text-sm/relaxed text-zinc-600 dark:text-zinc-400">
              {post.data.description}
            </p>
          </a>
        </li>
      ))}
    </ul>
  )
}
