---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StructuredData from "../components/StructuredData.astro";
import { SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  schema?: {
    type?: "website" | "article" | "faq";
    datePublished?: string;
    dateModified?: string;
    faq?: { q: string; a: string }[];
    breadcrumbs?: { name: string; url: string }[];
  };
}

const {
  title,
  description = SITE.description,
  ogType = "website",
  schema,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const base = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL("/og.jpg", base).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      Favicons: SVG first for modern browsers, a modestly sized PNG as the
      raster fallback. Keep these files small — an oversized PNG here is
      silently ignored by some browsers.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta name="theme-color" content="#0b0b0d" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <StructuredData
      type={schema?.type ?? (ogType === "article" ? "article" : "website")}
      title={title}
      description={description}
      url={canonical}
      datePublished={schema?.datePublished}
      dateModified={schema?.dateModified}
      faq={schema?.faq}
      breadcrumbs={schema?.breadcrumbs}
    />

    <!-- Apply the stored theme before paint to avoid a flash. -->
    <script is:inline>
      /* Dark is the default; only an explicit light choice turns it off. */
      if (localStorage.getItem("theme") !== "light") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-white font-sans text-zinc-900 antialiased dark:bg-ink-950 dark:text-zinc-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-zinc-950 focus:shadow-lg dark:focus:bg-ink-900 dark:focus:text-white"
    >
      Skip to content
    </a>
    <SiteNav />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
