---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import BrandStrip from "../components/sections/BrandStrip.astro";
import FormattedDate from "../components/FormattedDate.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  backHref,
  backLabel,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  schema={{
    type: "article",
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
  }}
>
  <article>
    <header class="border-b border-zinc-200 dark:border-white/10">
      <Container width="prose" class="py-14 sm:py-16">
        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 font-mono text-xs tracking-wide text-zinc-500 uppercase transition-colors hover:text-accent-600 dark:text-zinc-500 dark:hover:text-accent-300"
        >
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          {backLabel}
        </a>

        <h1
          class="mt-6 text-3xl font-semibold tracking-tight text-zinc-950 sm:text-4xl dark:text-white"
        >
          {title}
        </h1>
        <p class="mt-4 text-lg/relaxed text-zinc-600 dark:text-zinc-400">
          {description}
        </p>

        <div
          class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-zinc-500 dark:text-zinc-500"
        >
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span>· updated <FormattedDate date={updatedDate} /></span>
          )}
          {
            tags.length > 0 && (
              <span class="flex flex-wrap gap-2">
                {tags.map((t) => (
                  <span class="rounded-full border border-zinc-200 px-2 py-0.5 text-zinc-600 dark:border-white/15 dark:text-zinc-400">
                    {t}
                  </span>
                ))}
              </span>
            )
          }
        </div>
      </Container>
    </header>

    <BrandStrip />

    <Container width="prose" class="py-14 sm:py-16">
      <div
        class="prose prose-zinc max-w-none dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-accent-700 prose-a:decoration-accent-300 hover:prose-a:text-accent-600 dark:prose-a:text-accent-300 dark:prose-a:decoration-accent-700 dark:hover:prose-a:text-accent-200 prose-pre:border prose-pre:border-zinc-200 prose-pre:bg-zinc-50 dark:prose-pre:border-white/10 dark:prose-pre:bg-white/[0.03]"
      >
        <slot />
      </div>
    </Container>
  </article>
</BaseLayout>
