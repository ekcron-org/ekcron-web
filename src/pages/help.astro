---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import BrandStrip from "../components/sections/BrandStrip.astro";
import FaqList from "../components/FaqList.astro";
import Button from "../components/ui/Button.astro";
import { FAQ, CONTACT } from "../consts";
---

<BaseLayout
  title="Help"
  description="Answers to common questions about the platform, data handling, and getting started."
  schema={{ type: "faq", faq: FAQ }}
>
  <PageHeader
    eyebrow="Help"
    title="Frequently asked questions"
    lede="If something here is unclear or missing, just ask."
  />
  <BrandStrip />

  <Container width="prose" class="py-14 sm:py-16">
    <FaqList items={FAQ} />

    <div
      class="mt-14 rounded-xl border border-zinc-200 bg-zinc-50/60 p-7 dark:border-white/10 dark:bg-white/[0.03]"
    >
      <h2 class="text-lg font-medium text-zinc-950 dark:text-white">Still stuck?</h2>
      <p class="mt-2 text-[0.9375rem]/relaxed text-zinc-600 dark:text-zinc-400">
        Send over the details and I'll take a look.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href="/contact">Contact</Button>
        <Button href={`mailto:${CONTACT.general}`} variant="secondary">
          {CONTACT.general}
        </Button>
      </div>
    </div>
  </Container>
</BaseLayout>
