---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { getPosts } from "../../lib/posts";
import { BLOG_PAGE_SIZE } from "../../consts";

const posts = await getPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
const pagePosts = posts.slice(0, BLOG_PAGE_SIZE);
---

<BaseLayout
  title="Blog"
  description="Notes on fine-tuning, distillation, evaluation, and running small language models."
>
  <PageHeader
    eyebrow="Blog"
    title="Writing"
    lede="Notes on fine-tuning, distillation, evaluation, and getting useful work out of small models."
  />

  <Container width="prose" class="py-10 sm:py-12">
    <PostList base="/blog" posts={pagePosts} empty="First posts coming soon." />
    <Pagination current={1} total={totalPages} />
  </Container>
</BaseLayout>
