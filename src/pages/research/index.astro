---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("research"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Research" description="Longer notes on distillation, small models, and evaluation.">
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Research</h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400">
      Longer-form notes on distillation, small models, and how to evaluate them.
    </p>
  </header>
  <PostList base="/research" posts={posts} empty="Research notes coming soon." />
</BaseLayout>
