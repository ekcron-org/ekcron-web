---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { SITE, TOPICS } from "../consts";

function published<T extends CollectionEntry<"blog"> | CollectionEntry<"research">>(
  posts: T[],
): T[] {
  return posts
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
}

const blog = published(await getCollection("blog")).slice(0, 4);
const research = published(await getCollection("research")).slice(0, 3);
---

<BaseLayout>
  <section class="py-6 md:py-10">
    <h1 class="text-4xl font-bold tracking-tight text-zinc-900 md:text-5xl dark:text-white">
      {SITE.tagline}
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
      {SITE.description}
    </p>
  </section>

  <section class="mt-8 grid gap-6 border-t border-zinc-200 pt-10 sm:grid-cols-3 dark:border-zinc-800">
    {
      TOPICS.map((t) => (
        <div>
          <h2 class="font-semibold text-zinc-900 dark:text-white">{t.title}</h2>
          <p class="mt-1.5 text-sm text-zinc-600 dark:text-zinc-400">{t.body}</p>
        </div>
      ))
    }
  </section>

  {
    research.length > 0 && (
      <section class="mt-14">
        <div class="flex items-baseline justify-between">
          <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Research</h2>
          <a href="/research" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">All research &rarr;</a>
        </div>
        <div class="mt-2">
          <PostList base="/research" posts={research} />
        </div>
      </section>
    )
  }

  <section class="mt-14">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Latest writing</h2>
      <a href="/blog" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">All posts &rarr;</a>
    </div>
    <div class="mt-2">
      <PostList base="/blog" posts={blog} empty="First posts coming soon." />
    </div>
  </section>
</BaseLayout>
